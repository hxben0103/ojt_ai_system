# =============================================================
# OJT AI System — Environment Variables Template
# =============================================================
# INSTRUCTIONS: Copy this file to config/env/.env and fill in your values.
# NEVER commit the actual .env file to version control (it's in .gitignore).
# =============================================================

# =============================================================
# Database (Supabase PostgreSQL with pgBouncer pooler)
# =============================================================
# Use the transaction pooler URL from: Project → Settings → Database → Connection Pooling
# Replace @ symbols in password with %40
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# =============================================================
# Supabase Storage (for attendance photos)
# =============================================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =============================================================
# Server Configuration
# =============================================================
PORT=3000
NODE_ENV=development  # Change to 'production' when deploying

# =============================================================
# JWT Secret
# REQUIRED: Generate a strong secret (e.g., openssl rand -hex 32)
# There is NO fallback — the server will refuse to start without this.
# =============================================================
JWT_SECRET=replace_with_a_strong_random_256bit_secret_at_least_32_characters

# =============================================================
# AI Services
# =============================================================
# Flask AI server URL (running server.py in ai_module/)
FLASK_AI_URL=http://localhost:5000

# Ollama LLM server (used by chatbot and recommendation engine)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma2:2b

# =============================================================
# API Base URL
# =============================================================
API_BASE_URL=http://localhost:3000/api
